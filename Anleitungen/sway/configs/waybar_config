{
    "layer": "top",
    "position": "top",
    "height": 35,
    "spacing": 4,

    "modules-left": [
        "sway/workspaces",
        "sway/mode"
    ],
    "modules-center": [
        "sway/window"
    ],
    "modules-right": [
        "custom/audio-output",
        "custom/audio-input",
        "pulseaudio",
        "custom/wifi",
        "network",
        "cpu",
        "memory",
        "battery",
        "clock"
    ],

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}",
        "format-icons": {
            "urgent": "",
            "focused": "",
            "default": ""
        }
    },

    "sway/window": {
        "format": "{}",
        "max-length": 50
    },

    "custom/audio-output": {
        "format": "[OUT]",
        "exec": "pactl get-default-sink | grep -q 'analog' && echo 'Speakers' || pactl get-default-sink | sed 's/.*\\.//; s/_/ /g' | cut -c1-8",
        "interval": 2,
        "on-click": "pavucontrol -t 3",
        "on-click-right": "~/.config/waybar/scripts/audio-output-switcher.sh",
        "tooltip": true,
        "tooltip-format": "Audio Output\nLinks: Mixer | Rechts: Wechseln"
    },

    "custom/audio-input": {
        "format": "[IN]",
        "exec": "echo 'MIC'",
        "interval": 2,
        "on-click": "pavucontrol -t 4",
        "on-click-right": "~/.config/waybar/scripts/audio-input-switcher.sh",
        "tooltip": true,
        "tooltip-format": "Audio Input\nLinks: Mixer | Rechts: Wechseln"
    },

    "pulseaudio": {
        "scroll-step": 1,
        "format": "{volume}% [VOL]",
        "format-bluetooth": "{volume}% [BT]",
        "format-bluetooth-muted": "MUTE [BT]",
        "format-muted": "MUTE [VOL]",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },

    "custom/wifi": {
        "format": "[NET]",
        "exec": "nmcli -t -f ACTIVE,SSID dev wifi | grep '^yes' | cut -d':' -f2 | head -c12",
        "interval": 10,
        "on-click": "nm-connection-editor",
        "on-click-right": "~/.config/waybar/scripts/wifi-switcher.sh",
        "tooltip": true,
        "tooltip-format": "WiFi Network\nLinks: Manager | Rechts: Wechseln"
    },

    "network": {
        "format-wifi": "{essid} ({signalStrength}%) [WIFI]",
        "format-ethernet": "{ipaddr}/{cidr} [ETH]",
        "format-linked": "{ifname} (No IP) [LINK]",
        "format-disconnected": "Disconnected [OFF]",
        "format-alt": "{ifname}: {ipaddr}/{cidr}",
        "interval": 10
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%A, %d. %B %Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "on-click-right": "mode",
            "format": {
                "months": "<span color='#FFC4EB'><b>{}</b></span>",
                "days": "<span color='#89CE94'><b>{}</b></span>",
                "weeks": "<span color='#197278'><b>W{}</b></span>",
                "weekdays": "<span color='#FFC4EB'><b>{}</b></span>",
                "today": "<span color='#000000' background='#FFC4EB'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% [BAT]",
        "format-charging": "{capacity}% [CHG]",
        "format-plugged": "{capacity}% [AC]",
        "format-alt": "{time} [BAT]",
        "interval": 30
    },

    "cpu": {
        "format": "{usage}% [CPU]",
        "tooltip": true,
        "interval": 5
    },

    "memory": {
        "format": "{}% [RAM]",
        "tooltip-format": "RAM: {used:0.1f}G/{total:0.1f}G",
        "interval": 5
    }
}