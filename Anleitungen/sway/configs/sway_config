# Optimierte Sway Konfiguration v4 - Enhanced Tuxedo Edition
# Farbpalette: #FFC4EB (Rosa), #197278 (Teal), #89CE94 (Grün), #2B2D42 (Dunkelblau), #000000 (Schwarz)
# /home/hex/.config/sway/config

### Variables
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term foot
set $menu wofi --show drun

### Output configuration
# Wallpaper
output * bg ~/.config/sway/wallpapers/1341696.jpeg fill

# Laptop-Display - ganz links
output eDP-1 {
    resolution 2560x1600@240Hz
    position 0,0
    scale 1.25
    adaptive_sync off
}

# Neuer Iiyama Monitor (SN: 12428JR400792) - Mitte
output "Iiyama North America PL2763Q 12428JR400792" {
    resolution 2560x1440@100Hz
    position 2048,0
    scale 1.0
    adaptive_sync off
}

# Alter Iiyama Monitor (SN: 12428JQ901271) - rechts
output "Iiyama North America PL2763Q 12428JQ901271" {
    resolution 2560x1440@100Hz
    position 4608,0
    scale 1.0
    adaptive_sync off
}

### Idle configuration
exec swayidle -w \
         timeout 1800 'swaylock -f -c 2B2D42' \
         timeout 2700 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
         before-sleep 'swaylock -f -c 2B2D42'

### Input configuration
input type:touchpad {
    dwt enabled
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
    scroll_method two_finger
}

input type:keyboard {
    xkb_layout "us"
    xkb_variant "altgr-intl"
}

### Basic Key bindings
bindsym $mod+Return exec $term
bindsym $mod+Shift+q kill
bindsym $mod+d exec $menu
floating_modifier $mod normal
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Sway beenden?' -B 'Ja, beenden' 'swaymsg exit'
bindsym $mod+Ctrl+l exec swaylock -f -c 2B2D42

### NEW: Power Menu
set $power_mode "Power: [l]ock [e]xit [s]uspend [r]eboot [p]oweroff"
mode $power_mode {
    bindsym l exec swaylock -f -c 2B2D42, mode "default"
    bindsym e exec swaymsg exit, mode "default"
    bindsym s exec systemctl suspend, mode "default"
    bindsym r exec systemctl reboot, mode "default"
    bindsym p exec systemctl poweroff, mode "default"
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+Shift+p mode $power_mode

### Tuxedo Function Keys - Audio (Fn+F6/F7/F8)
# Fn+F6 = Mute
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle && \
    notify-send -t 1000 "🔇 Audio" "$(pactl get-sink-mute @DEFAULT_SINK@ | grep -q 'yes' && echo 'Muted' || echo 'Unmuted')"

# Fn+F7 = Volume Down (MAX 100%)
bindsym XF86AudioLowerVolume exec sh -c '\
    pactl set-sink-volume @DEFAULT_SINK@ -5%; \
    VOL=$(pactl get-sink-volume @DEFAULT_SINK@ | grep -o "[0-9]*%" | head -1); \
    notify-send -t 800 "🔉 Volume" "$VOL"'

# Fn+F8 = Volume Up (MAX 100%)
bindsym XF86AudioRaiseVolume exec sh -c '\
    CURRENT=$(pactl get-sink-volume @DEFAULT_SINK@ | grep -o "[0-9]*%" | head -1 | tr -d "%"); \
    if [ "$CURRENT" -lt 100 ]; then \
        pactl set-sink-volume @DEFAULT_SINK@ +5%; \
        [ $(pactl get-sink-volume @DEFAULT_SINK@ | grep -o "[0-9]*%" | head -1 | tr -d "%") -gt 100 ] && pactl set-sink-volume @DEFAULT_SINK@ 100%; \
    fi; \
    VOL=$(pactl get-sink-volume @DEFAULT_SINK@ | grep -o "[0-9]*%" | head -1); \
    notify-send -t 800 "🔊 Volume" "$VOL"'

### Tuxedo Function Keys - Brightness (Fn+F1/F2) - TEST!
# Fn+F1 = Dunkler
bindsym XF86MonBrightnessDown exec sh -c '\
    brightnessctl set 10%-; \
    BRIGHT=$(brightnessctl | grep -o "[0-9]*%"); \
    notify-send -t 800 "🔅 Brightness" "$BRIGHT"'

# Fn+F2 = Heller
bindsym XF86MonBrightnessUp exec sh -c '\
    brightnessctl set +10%; \
    BRIGHT=$(brightnessctl | grep -o "[0-9]*%"); \
    notify-send -t 800 "☀️ Brightness" "$BRIGHT"'

### Screenshot Controls - Komplettes System
# 1. Vollbild-Screenshot (Print)
bindsym Print exec sh -c '\
    grim ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png && \
    notify-send -t 2000 "📸 Screenshot" "Vollbild gespeichert in ~/Pictures"'

# 2. Bereich auswählen und speichern (Shift+Print)
bindsym Shift+Print exec sh -c '\
    grim -g "$(slurp)" ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png && \
    notify-send -t 2000 "📸 Screenshot" "Bereich gespeichert in ~/Pictures"'

# 3. Bereich in Zwischenablage (Ctrl+Print)
bindsym Ctrl+Print exec sh -c '\
    grim -g "$(slurp)" - | wl-copy && \
    notify-send -t 2000 "📋 Screenshot" "In Zwischenablage kopiert"'

# 4. OCR Screenshot - Text extrahieren (Alt+Print) - benötigt tesseract
bindsym Alt+Print exec sh -c '\
    grim -g "$(slurp)" /tmp/ocr-screenshot.png && \
    tesseract /tmp/ocr-screenshot.png - | wl-copy && \
    rm /tmp/ocr-screenshot.png && \
    notify-send -t 3000 "📝 OCR Screenshot" "Text in Zwischenablage kopiert"'

# 5. Aktives Fenster screenshotten (Mod+Print)
bindsym $mod+Print exec sh -c '\
    grim -g "$(swaymsg -t get_tree | jq -r '"'"'.. | select(.focused?) | .rect | "\(.x),\(.y) \(.width)x\(.height)"'"'"')" \
    ~/Pictures/window-screenshot-$(date +%Y%m%d-%H%M%S).png && \
    notify-send -t 2000 "📸 Window Screenshot" "Gespeichert in ~/Pictures"'

